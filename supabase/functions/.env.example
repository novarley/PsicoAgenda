# Copiar a supabase/functions/.env para `supabase functions serve` (NO subir a git).
# En producción: supabase secrets set --env-file supabase/functions/.env
# SUPABASE_URL y SUPABASE_SERVICE_ROLE_KEY los inyecta Supabase automáticamente.

# --- Meta WhatsApp Cloud API (developers.facebook.com → tu app → WhatsApp) ---
WHATSAPP_VERIFY_TOKEN=cadena-aleatoria-que-tambien-pones-en-meta
WHATSAPP_APP_SECRET=app-secret-de-la-app-de-meta
WHATSAPP_ACCESS_TOKEN=token-de-usuario-del-sistema-permanente
WHATSAPP_GRAPH_VERSION=v23.0

# --- pg_cron → dispatcher (el mismo valor que el secreto de Vault "dispatcher_secret") ---
DISPATCHER_SECRET=cadena-aleatoria-de-32-o-mas-caracteres

# --- Cifrado de notas clínicas: openssl rand -base64 32 ---
CLINICAL_DATA_KEY=

# --- Wompi (opcional; sin estas claves el bot reserva y recepción cobra el anticipo) ---
WOMPI_PUBLIC_KEY=pub_test_xxx
WOMPI_INTEGRITY_SECRET=test_integrity_xxx
PAYMENT_REDIRECT_URL=https://tu-panel.pages.dev/pago-recibido

# URL del panel a la que vuelve el enlace de invitación del personal
PANEL_URL=https://tu-panel.pages.dev

PRIVACY_POLICY_URL=https://tu-panel.pages.dev/privacidad
